TENANT_ID              # Azure AD Tenant ID
BACKEND_CLIENT_ID      # Client ID backend
BACKEND_CLIENT_SECRET  # Secret backend
FRONTEND_CLIENT_ID     # Client ID frontend

# Microsoft Graph (Service-to-Service)
