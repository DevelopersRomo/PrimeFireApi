            html_parts.append(
                f'                <td class="result test-result {css_class}">{icon}<span class="rate">{triggers}/{runs}</span></td>\n'
            )

        html_parts.append("            </tr>\n")

    html_parts.extend(("""        </tbody>\r\n    </table>\r\n    </div>\r\n""", """\r\n</body>\r\n</html>\r\n"""))

    return "".join(html_parts)


def main():
